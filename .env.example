# Select one: openrouter, google, groq, hetzner
LLM_ACTIVE_PROVIDER=openrouter

# Maximum output tokens per S4 LLM call.
S4_WRITER_MAX_TOKENS=20000
S4_CRITIC_MAX_TOKENS=8000

# Max estimated input tokens per writer request. Groq free tier rejects >8000 tokens/minute (HTTP 413).
# On a paid tier, delete this line.
S4_MAX_INPUT_TOKENS=7800

# DEV ONLY: if the Story Critic is not satisfied the writer revises the script (using the Critic's notes)
# until S4_MAX_ATTEMPTS (default 3) is used up; then the best script is returned instead of failing.
# Remove this line (or set 0) for strict behavior. Scoring and explanatory thresholds are fixed in code.
S4_CRITIC_ADVISORY=1

# Conditional continuity audit for accepted candidates or Critic continuity concerns.
# 0 disables it; it is not run on every attempt.
S4_CONTINUITY_AUDIT=1
S4_CONTINUITY_MAX_TOKENS=6000

# Safety audit: a structured pass that lists hazardous actions, who performs them and what safeguard
# the story shows. Code checks cited lines against the cast. It runs on every code-valid draft;
# drafts that fail code checks skip this call unless S4_SAFETY_EARLY is enabled.
# Independent audit: enabled by default, with contextual minor/serious risk tiers.
S4_SAFETY_AUDIT=1
S4_SAFETY_MAX_TOKENS=4000
# Audit drafts that already failed code checks only when explicitly enabled. Normal repair attempts
# defer this call until a draft could otherwise be accepted, or the Critic flags a safety concern.
S4_SAFETY_EARLY=0

# Independent educational-accuracy audit, run only after the Story Critic accepts a draft.
# It compares concept-linked claims to the source lesson and fails closed if unsupported/unavailable.
# This adds one model call for each candidate that otherwise passes S4.
S4_FACT_ACCURACY_AUDIT=1
S4_FACT_ACCURACY_MAX_TOKENS=8000

# Aggregate run log read by scripts/summarize_runs.py (default logs/s4_runs.jsonl).
# S4_RUN_LOG_PATH=logs/s4_runs.jsonl

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL_LARGE=openai/gpt-6-luna
OPENROUTER_MODEL_SMALL=openai/gpt-6-luna
OPENROUTER_MODEL_VISION=openai/gpt-6-luna

# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL_LARGE=gemini-2.5-flash
GOOGLE_MODEL_SMALL=gemini-2.5-flash-lite
GOOGLE_MODEL_VISION=gemini-2.5-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=qwen/qwen3.8-27b
GROQ_MODEL_VISION=qwen/qwen3.8-27b

# Hetzner Inference: experimental, free while experimental, no production SLA.
# Create a token at https://experiments.hetzner.com/inference
HETZNER_API_KEY=
HETZNER_MODEL_LARGE=Qwen/Qwen3.6-35B-A3B-FP8
HETZNER_MODEL_SMALL=Qwen3.8-27B
HETZNER_MODEL_VISION=Qwen/Qwen3.6-35B-A3B-FP8

# Aggregate token budget for a single S4 story run (input + output across attempts).
MAX_TOKENS_PER_STORY=600000

# Opt-in retry feedback and compact validation trace (may contain story/lesson text)
S4_RUN_LOG_REPAIR_DETAILS=false
