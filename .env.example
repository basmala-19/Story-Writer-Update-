# Select one: openrouter, google, groq, hetzner
LLM_ACTIVE_PROVIDER=openrouter

# Maximum output tokens per S4 LLM call.
S4_WRITER_MAX_TOKENS=20000
S4_CRITIC_MAX_TOKENS=8000

# Max estimated input tokens per writer request. Groq free tier rejects >8000 tokens/minute (HTTP 413).
# On a paid tier, delete this line.
S4_MAX_INPUT_TOKENS=7800

# DEV ONLY: if the Story Critic is not satisfied the writer revises the script (using the Critic's notes)
# until S4_MAX_ATTEMPTS (default 3) is used up; then the best script is returned instead of failing.
# Remove this line (or set 0) for production. Individual thresholds can also be relaxed with
# S4_CRITIC_MIN_SCORE (4.0), S4_CRITIC_MIN_MEAN (4.2), S4_CRITIC_MAX_EXPLANATORY (0.25).
S4_CRITIC_ADVISORY=1

# Continuity audit before the Critic (ledger of object/quantity states, checks character claims).
# 0 disables it. Costs one extra call per attempt that reaches the Critic.
S4_CONTINUITY_AUDIT=1
S4_CONTINUITY_MAX_TOKENS=6000

# Aggregate run log read by scripts/summarize_runs.py (default logs/s4_runs.jsonl).
# S4_RUN_LOG_PATH=logs/s4_runs.jsonl

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL_LARGE=openai/gpt-6-luna
OPENROUTER_MODEL_SMALL=openai/gpt-6-luna
OPENROUTER_MODEL_VISION=openai/gpt-6-luna

# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL_LARGE=gemini-2.5-flash
GOOGLE_MODEL_SMALL=gemini-2.5-flash-lite
GOOGLE_MODEL_VISION=gemini-2.5-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=qwen/qwen3.8-27b
GROQ_MODEL_VISION=qwen/qwen3.8-27b

# Hetzner Inference: experimental, free while experimental, no production SLA.
# Create a token at https://experiments.hetzner.com/inference
HETZNER_API_KEY=
HETZNER_MODEL_LARGE=Qwen/Qwen3.6-35B-A3B-FP8
HETZNER_MODEL_SMALL=Qwen3.8-27B
HETZNER_MODEL_VISION=Qwen/Qwen3.6-35B-A3B-FP8
# Borderline-score re-check (a 3.5 with no major issue behind it gets one narrow second look).
# S4_RECHECK=0 turns it off (then every 3.5 fails, the strict rule).
S4_RECHECK=1
S4_RECHECK_MAX_TOKENS=3000
